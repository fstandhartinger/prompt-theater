DATABASE_URL=postgres://prompt_theater:change-me@postgres:5432/prompt_theater
FAL_KEY=replace-me
FAL_MODEL=minimax/h3-max/text-to-video
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_USD=400
# Prices are charged as gross amounts; set to 0 only if Stripe Tax is not configured.
STRIPE_AUTOMATIC_TAX=1
PUBLIC_URL=http://localhost:3000
SCENE_SECONDS=15
MAX_DAILY_SPEND_USD=20
OPENROUTER_API_KEY=replace-me
MODERATION_MODEL=z-ai/glm-5.3-flash
X_RTMP_URL=
X_RTMP_KEY=
DATA_DIR=/data
RETENTION_DAYS=30
# Local development only. FAL_FAKE renders a placeholder clip instead of calling fal.
# MODERATION_FAKE approves every prompt without calling OpenRouter and must stay off in
# production; the app refuses to start without OPENROUTER_API_KEY unless it is set.
FAL_FAKE=0
MODERATION_FAKE=0
